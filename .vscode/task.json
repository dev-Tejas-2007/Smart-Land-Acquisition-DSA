{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build-landwise",
            "command": "g++",
            "args": [
                "${workspaceFolder}/cpp/main.cpp",
                "-o",
                "${workspaceFolder}/landwise.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}